# Kopieer dit bestand naar .env.local en vul in.

# Resend API key (https://resend.com). Zonder key draait de app in demo-modus:
# mails worden dan niet verstuurd maar getoond in de UI en gelogd in de console.
RESEND_API_KEY=

# Afzenderadres voor mails. Zonder geverifieerd domein bij Resend kun je
# "onboarding@resend.dev" gebruiken (mailt alleen naar je eigen Resend-account).
EMAIL_FROM=Kapper Sint Niklaas <onboarding@resend.dev>

# E-mailadres van de salon: ontvangt een notificatie bij elke nieuwe boeking.
SALON_EMAIL=salon@example.com
